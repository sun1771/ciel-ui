{
  "name": "@cielui/react",
  "version": "0.1.1",
  "description": "Accessible, themeable React 19 components: WCAG 2.2 AA in light and dark themes",
  "license": "MIT",
  "author": {
    "name": "Sanaz Khanali",
    "url": "https://www.sunnyk.net/"
  },
  "homepage": "https://docs-ciel-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sun1771/ciel-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/sun1771/ciel-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/fix-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src .storybook",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook --project storybook-dark",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@cielui/icons": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cielui/tokens": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^10.6.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

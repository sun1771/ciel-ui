{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@acme/tokens#build": {
      "outputs": ["tokens.css"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "@acme/tokens#test": {
      "outputs": []
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    }
  }
}
